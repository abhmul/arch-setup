# Miscellaneous and category theory

priority 4
context math(context)
snippet tayl "Taylor expansion" iA
${1:f}(${2:x} + ${3:h}) = ${1:f}(${2:x}) + ${1:f}'(${2:x})${3:h} + ${1:f}''(${2:x}) \frac{${3:h}^{2}}{2!} + \dots${4}$0
endsnippet

context math(context)
snippet `iden(\\d+)` "N x N identity matrix" A
``
const n = Number(m[1]);
const rows = Array.from({ length: n }, (_, row) =>
    Array.from({ length: n }, (_, column) => row === column ? "1" : "0").join(" & ")
);
rv = "\\begin{pmatrix}\n" + rows.join(" \\\\\n") + "\n\\end{pmatrix}";
``
endsnippet

